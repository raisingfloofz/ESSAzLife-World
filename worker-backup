
const ALLOWED_ORIGINS = new Set([
  "https://raisingfloofz.github.io",
  "http://localhost:5500",
  "http://127.0.0.1:5500"
]);

const encoder = new TextEncoder();
const decoder = new TextDecoder();

function json(data, status = 200, headers = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      ...headers
    }
  });
}

function cors(origin) {
  return ALLOWED_ORIGINS.has(origin)
    ? {
        "Access-Control-Allow-Origin": origin,
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization",
        "Vary": "Origin"
      }
    : {};
}

function toHex(bytes) {
  return Array.from(bytes, b =>
    b.toString(16).padStart(2, "0")
  ).join("");
}

function fromHex(value) {
  if (!/^(?:[0-9a-f]{2})+$/i.test(value)) {
    throw new Error("Invalid hash");
  }
  return Uint8Array.from(
    value.match(/../g),
    x => parseInt(x, 16)
  );
}

function base64url(bytes) {
  let text = "";
  for (const b of bytes) text += String.fromCharCode(b);
  return btoa(text)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function decode64(value) {
  const s = value.replace(/-/g, "+").replace(/_/g, "/");
  return Uint8Array.from(
    atob(s + "=".repeat((4 - s.length % 4) % 4)),
    c => c.charCodeAt(0)
  );
}

async function hashPassword(password, salt) {
  const key = await crypto.subtle.importKey(
    "raw",
    encoder.encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );

  const bits = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      hash: "SHA-256",
      salt,
      iterations: 100000
    },
    key,
    256
  );

  return toHex(new Uint8Array(bits));
}

async function signingKey(secret) {
  return crypto.subtle.importKey(
    "raw",
    encoder.encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign", "verify"]
  );
}

async function createToken(id, secret) {
  const now = Math.floor(Date.now() / 1000);

  const payload = base64url(
    encoder.encode(JSON.stringify({
      sub: id,
      iat: now,
      exp: now + 86400
    }))
  );

  const signature = await crypto.subtle.sign(
    "HMAC",
    await signingKey(secret),
    encoder.encode(payload)
  );

  return payload + "." +
    base64url(new Uint8Array(signature));
}

async function verifyToken(request, secret) {
  const header = request.headers.get("Authorization") || "";

  if (!header.startsWith("Bearer ")) return null;

  const parts = header.slice(7).split(".");
  if (
    parts.length !== 2 ||
    parts[0].length > 2000 ||
    parts[1].length > 200
  ) return null;

  try {
    const valid = await crypto.subtle.verify(
      "HMAC",
      await signingKey(secret),
      decode64(parts[1]),
      encoder.encode(parts[0])
    );

    if (!valid) return null;

    const payload = JSON.parse(
      decoder.decode(decode64(parts[0]))
    );

    if (
      typeof payload.sub !== "string" ||
      !Number.isSafeInteger(payload.exp) ||
      payload.exp <= Date.now() / 1000
    ) return null;

    return payload.sub;
  } catch {
    return null;
  }
}

async function readBody(request) {
  if (
    !request.headers.get("Content-Type")
      ?.includes("application/json")
  ) return null;

  const length = Number(
    request.headers.get("Content-Length") || 0
  );

  if (length > 4096) return null;

  const raw = await request.text();
  if (raw.length > 4096) return null;

  try {
    const data = JSON.parse(raw);
    return data && typeof data === "object" &&
      !Array.isArray(data) ? data : null;
  } catch {
    return null;
  }
}


async function checkRateLimit(env, key, limit, windowSeconds) {
  const now = Math.floor(Date.now() / 1000);
  const resetBefore = now - windowSeconds;

  const result = await env.DB.prepare(`
    INSERT INTO auth_attempts
      (key, attempts, window_start, blocked_until)
    VALUES (?, 1, ?, 0)
    ON CONFLICT(key) DO UPDATE SET
      attempts = CASE
        WHEN window_start <= ? THEN 1
        ELSE attempts + 1
      END,
      window_start = CASE
        WHEN window_start <= ? THEN ?
        ELSE window_start
      END
    WHERE window_start <= ? OR attempts < ?
    RETURNING attempts
  `).bind(
    key, now,
    resetBefore,
    resetBefore, now,
    resetBefore, limit
  ).first();

  return result !== null;
}

async function authRateLimit(request, env, action, username = "") {
  const ip = request.headers.get("CF-Connecting-IP") || "unknown";

  const keyMaterial = new TextEncoder().encode(
    action + ":" + ip
  );

  const secretKey = await signingKey(env.SESSION_SECRET);
  const signature = await crypto.subtle.sign(
    "HMAC", secretKey, keyMaterial
  );

  const ipKey = action + ":ip:" +
    toHex(new Uint8Array(signature));

  const ipAllowed = await checkRateLimit(
    env,
    ipKey,
    action === "register" ? 3 : 10,
    action === "register" ? 3600 : 900
  );

  if (!ipAllowed) return false;

  if (action === "login" && username) {
    const nameAllowed = await checkRateLimit(
      env,
      "login:user:" + username.toLowerCase(),
      20,
      900
    );

    if (!nameAllowed) return false;
  }

  return true;
}


export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";
    const headers = cors(origin);
    const path = new URL(request.url).pathname;

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: ALLOWED_ORIGINS.has(origin) ? 204 : 403,
        headers
      });
    }

    if (origin && !ALLOWED_ORIGINS.has(origin)) {
      return json({ error: "Origin not allowed" }, 403, headers);
    }

    if (!env.DB || !env.SESSION_SECRET) {
      return json({ error: "Server not configured" }, 503, headers);
    }

    try {
      if (request.method === "GET" && path === "/health") {
        return json({
          ok: true,
          service: "essazlife-world-auth"
        }, 200, headers);
      }

      if (request.method === "POST" && path === "/register") {
        const data = await readBody(request);
        if (!data) return json({ error: "Invalid JSON" }, 400, headers);

        const { username, nickname, password } = data;

        if (
          typeof username !== "string" ||
          !/^[a-zA-Z0-9_]{3,24}$/.test(username) ||
          typeof nickname !== "string" ||
          nickname.trim().length < 1 ||
          nickname.trim().length > 40 ||
          typeof password !== "string" ||
          password.length < 12 ||
          password.length > 128
        ) {
          return json({
            error: "Username must be 3–24 letters, numbers or underscores; nickname 1–40 characters; password 12–128 characters."
          }, 400, headers);
        }

        
if (!await authRateLimit(request, env, "register")) {
  return json({
    error: "Too many registration attempts. Please try again later."
  }, 429, {
    ...headers,
    "Retry-After": "3600"
  });
}


        const id = crypto.randomUUID();
        const salt = crypto.getRandomValues(new Uint8Array(16));
        const hash = await hashPassword(password, salt);

        try {
          await env.DB.prepare(
            `INSERT INTO world_accounts
             (id, username, nickname, password_hash, password_salt)
             VALUES (?, ?, ?, ?, ?)`
          ).bind(
            id, username, nickname.trim(), hash, toHex(salt)
          ).run();
        } catch (error) {
          if (String(error).includes("UNIQUE constraint failed")) {
            return json({
              error: "Username already taken"
            }, 409, headers);
          }
          throw error;
        }

        return json({
          token: await createToken(id, env.SESSION_SECRET),
          account: { id, username, nickname: nickname.trim() }
        }, 201, headers);
      }

      if (request.method === "POST" && path === "/login") {
        const data = await readBody(request);

        if (
          !data ||
          typeof data.username !== "string" ||
          typeof data.password !== "string" ||
          data.username.length > 24 ||
          data.password.length > 128
        ) {
          return json({ error: "Invalid login" }, 400, headers);
        }

        
if (!await authRateLimit(
  request,
  env,
  "login",
  data.username
)) {
  return json({
    error: "Too many login attempts. Please try again later."
  }, 429, {
    ...headers,
    "Retry-After": "900"
  });
}


        const account = await env.DB.prepare(
          `SELECT id, username, nickname,
                  password_hash, password_salt
           FROM world_accounts
           WHERE username = ?`
        ).bind(data.username).first();

        if (!account) {
          return json({
            error: "Incorrect username or password"
          }, 401, headers);
        }

        const enteredHash = await hashPassword(
          data.password,
          fromHex(account.password_salt)
        );

        const valid = fromHex(enteredHash);
        const expected = fromHex(account.password_hash);

        let difference = 0;
        for (let i = 0; i < valid.length; i++) {
          difference |= valid[i] ^ expected[i];
        }

        if (difference !== 0) {
          return json({
            error: "Incorrect username or password"
          }, 401, headers);
        }

        return json({
          token: await createToken(
            account.id,
            env.SESSION_SECRET
          ),
          account: {
            id: account.id,
            username: account.username,
            nickname: account.nickname
          }
        }, 200, headers);
      }

      if (request.method === "GET" && path === "/me") {
        const id = await verifyToken(
          request,
          env.SESSION_SECRET
        );

        if (!id) {
          return json({ error: "Not authenticated" }, 401, headers);
        }

        const account = await env.DB.prepare(
          `SELECT id, username, nickname
           FROM world_accounts WHERE id = ?`
        ).bind(id).first();

        return account
          ? json({ account }, 200, headers)
          : json({ error: "Not authenticated" }, 401, headers);
      }

      return json({ error: "Not found" }, 404, headers);

    } catch (error) {
      console.error("Authentication error:", error);
      return json({ error: "Server error" }, 500, headers);
    }
  }
};
